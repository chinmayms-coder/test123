# Credentials for the Exotel MCP server (see .mcp.json).
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit actual credentials.

# Base64("<api_key>:<api_token>") — used for the general SMS/Voice Authorization header.
EXOTEL_TOKEN=

# Registered Exotel caller ID / from-number, e.g. +918069451234
EXOTEL_CALLER_ID=

# Exotel account SID / account ID
EXOTEL_ACCOUNT_ID=

# Exotel CPaaS API key/token used for placing bot-powered calls
EXOTEL_CALLS_API_KEY=
EXOTEL_CALLS_API_TOKEN=

# Exotel Calls API base URL
EXOTEL_CALLS_BASE_URL=https://api.in.exotel.com
